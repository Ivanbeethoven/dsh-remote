    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/brand_accent"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="6"
        android:pathData="M31,36 L54,54 L31,72" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/brand_ink"
