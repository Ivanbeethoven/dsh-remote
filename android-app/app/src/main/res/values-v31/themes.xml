<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ 的系统启动画面：用图标前景 + 同色底，和 App 首帧无缝衔接。
      windowSplashScreen* 属性从 API 31 起才存在，所以单独放在 values-v31。
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/brand_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
